# ─── Supabase ──────────────────────────────────────────────────────────────────
# Encontre em: supabase.com → seu projeto → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Mercado Pago ───────────────────────────────────────────────────────────────
# Encontre em: mercadopago.com.br → Suas integrações → Credenciais
# Use as credenciais de TESTE para desenvolvimento (começam com TEST-)
# Use as de PRODUÇÃO apenas no deploy final (começam com APP_USR-)

MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000

# Segredo do webhook — gerado ao criar o webhook no painel do MP
# Deixe em branco em desenvolvimento se não for testar o webhook
MERCADOPAGO_WEBHOOK_SECRET=

# ─── Anthropic (Claude) ─────────────────────────────────────────────────────────
# Encontre em: console.anthropic.com → API Keys

ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Google Places API (opcional) ───────────────────────────────────────────────
# Necessário para a análise de Google Business Profile
# Encontre em: console.cloud.google.com → APIs → Places API → Credenciais
# Se não configurar, o módulo Google Business é pulado graciosamente

GOOGLE_PLACES_API_KEY=AIzaSy...

# ─── DataForSEO (opcional) ──────────────────────────────────────────────────────
# Necessário para sugestões de palavras-chave com volume real
# Encontre em: app.dataforseo.com → API Access
# Se não configurar, as palavras-chave são geradas pelo Claude (menos precisas)

DATAFORSEO_LOGIN=seu@email.com
DATAFORSEO_PASSWORD=sua_senha_dataforseo

# ─── Resend (opcional) ──────────────────────────────────────────────────────────
# Necessário para envio de e-mails transacionais (confirmação de pagamento,
# relatório pronto, etc.)
# Encontre em: resend.com → API Keys
# Se não configurar, os e-mails são ignorados silenciosamente

RESEND_API_KEY=re_...

# ─── App ────────────────────────────────────────────────────────────────────────
# URL base da aplicação — use localhost em desenvolvimento

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Em produção: NEXT_PUBLIC_APP_URL=https://rankbr.com.br
