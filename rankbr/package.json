    "mercadopago": "^2.4.3",
    "next": "14.2.21",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.54.2",
    "resend": "^6.10.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^4.1.4",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.21",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8",
